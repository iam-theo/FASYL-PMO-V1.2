# Copy to .env and fill with your own values. Never commit .env.
# The local dev defaults below work with a stock PostgreSQL install.

# Backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fasyl_pmo_db"
JWT_SECRET="dev-only-secret-change-in-production"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-in-production"
ACCESS_TOKEN_EXPIRES_IN="30m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Swagger "servers" entry shown in /docs
PUBLIC_API_URL="http://localhost:5000/api/v1"

# Public base URL used to build file URLs returned to clients (no trailing slash)
PUBLIC_BASE_URL="http://localhost:5000"

# Directory multer writes uploads to (auto-created on startup)
# UPLOAD_DIR="backend/uploads/"

# Max upload size in MB. Vercel Functions hard-cap request bodies at 4.5MB, so
# the Vercel project must set MAX_UPLOAD_MB=4 (and the frontend VITE_MAX_UPLOAD_MB=4).
# MAX_UPLOAD_MB="5"

# Vercel Blob read/write token. When set, uploads go to Vercel Blob instead of
# the local UPLOAD_DIR and the returned file URL points at Blob.
# BLOB_READ_WRITE_TOKEN=""

# Upstash Redis URL. When set, realtime events fan out across serverless
# instances via pub/sub. Without it the realtime hub is single-instance only.
# REDIS_URL="redis://..."

# Secret that guards the Vercel Cron endpoints (Authorization: Bearer <secret>).
# CRON_SECRET=""

# Comma-separated list of allowed browser origins (defaults to the two localhost dev ports)
# CORS_ORIGINS="https://app.example.com"

# Sales API the every-minute sync cron pulls projects from
SALES_API_URL=""

# SMTP used by the notification service (assignment emails).
# Without these, sendEmail logs "SMTP not configured" and skips quietly.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FASYL PMO <no-reply@fasyl.com>"

# Base URL used for links inside notification emails (the frontend app).
# APP_BASE_URL="http://localhost:5173"

# Frontend (VITE_-prefixed; only read at build time by Vite)
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Frontend WebSocket URL (defaults to the same host as VITE_API_BASE_URL).
# Only needed when the WS endpoint lives elsewhere. On Vercel, leave unset —
# the client derives wss://<origin>/ws from the relative VITE_API_BASE_URL.
# VITE_WS_URL="wss://app.example.com/ws"

# Frontend max upload size in MB (mirrors backend MAX_UPLOAD_MB). Set to 4 on Vercel.
# VITE_MAX_UPLOAD_MB="5"
