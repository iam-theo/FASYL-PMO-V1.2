# Copy to .env and fill with your own values. Never commit .env.
# The local dev defaults below work with a stock PostgreSQL install.

# Backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fasyl_pmo_db"
JWT_SECRET="dev-only-secret-change-in-production"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-in-production"
ACCESS_TOKEN_EXPIRES_IN="30m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Swagger "servers" entry shown in /docs
PUBLIC_API_URL="http://localhost:5000/api/v1"

# Public base URL used to build file URLs returned to clients (no trailing slash)
PUBLIC_BASE_URL="http://localhost:5000"

# Directory multer writes uploads to (auto-created on startup)
# UPLOAD_DIR="backend/uploads/"

# Comma-separated list of allowed browser origins (defaults to the two localhost dev ports)
# CORS_ORIGINS="https://app.example.com"

# Sales API the every-minute sync cron pulls projects from
SALES_API_URL=""

# SMTP used by the notification service (assignment emails).
# Without these, sendEmail logs "SMTP not configured" and skips quietly.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FASYL PMO <no-reply@fasyl.com>"

# Base URL used for links inside notification emails (the frontend app).
# APP_BASE_URL="http://localhost:5173"

# Frontend (VITE_-prefixed; only read at build time by Vite)
VITE_API_BASE_URL="http://localhost:5000/api/v1"
